<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent for the local docs-sync (daily). Builds any new engine release's
     docs bundle from its tag and lands it UNCOMMITTED for your review.
     Install / reinstall:
       cp "scripts/io.memql.docs-sync.plist" ~/Library/LaunchAgents/
       launchctl unload ~/Library/LaunchAgents/io.memql.docs-sync.plist 2>/dev/null
       launchctl load   ~/Library/LaunchAgents/io.memql.docs-sync.plist
     Run once now (without waiting for the schedule):
       launchctl start io.memql.docs-sync
     Turn off:
       launchctl unload ~/Library/LaunchAgents/io.memql.docs-sync.plist
     Watch it:
       tail -f ~/Library/Logs/memql-docs-autosync.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.memql.docs-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jmendivil/MemQL Website/scripts/docs-sync.sh</string>
    </array>

    <!-- Daily at 06:30 local. launchd coalesces a run missed while asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Also run once when loaded (login), so it self-heals promptly. -->
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/jmendivil/MemQL Website</string>

    <!-- Belt-and-suspenders PATH; docs-sync.sh also sets its own. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/go/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jmendivil/Library/Logs/memql-docs-autosync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jmendivil/Library/Logs/memql-docs-autosync.log</string>
</dict>
</plist>
